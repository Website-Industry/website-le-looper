---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Données agenda : tous les événements (à venir + archives). date = ISO YYYY-MM-DD ou null ("En discussion").
const allAgendaEvents = [
  { date: '2026-02-22', dateLabel: 'Dimanche 22 février 2026', title: 'Atelier "Horizon Live Coding #2"', time: '14h - 16h', desc: 'Découverte de Strudel.cc', location: '📍 <a href="https://eurekafe.fr/" target="_blank" rel="noopener noreferrer" class="event-location-link">Eurêkafé</a>, 5 Impasse Colombette, Toulouse', links: [{ href: '/horizon-live-coding.html', text: 'Découvrir le format →', secondary: true }, { href: 'https://luma.com/b3xenym8', text: 'Plus d\'info →' }] },
  { date: '2026-03-08', dateLabel: 'Samedi 8 mars 2026', title: 'Atelier "Horizon Live Coding #3"', time: '14h - 16h', desc: 'Session de pratique collective de live coding', location: '📍 <a href="https://eurekafe.fr/" target="_blank" rel="noopener noreferrer" class="event-location-link">Eurêkafé</a>, 5 Impasse Colombette, Toulouse', links: [{ href: '/horizon-live-coding.html', text: 'Découvrir le format →', secondary: true }, { href: 'https://luma.com/0m6imtz6', text: 'Plus d\'info →' }] },
  { date: '2026-04-19', dateLabel: 'Samedi 19 avril 2026', title: 'Atelier "Horizon Live Coding #4"', time: '14h - 16h', desc: 'Session de pratique collective de live coding', location: '📍 <a href="https://eurekafe.fr/" target="_blank" rel="noopener noreferrer" class="event-location-link">Eurêkafé</a>, 5 Impasse Colombette, Toulouse', links: [{ href: '/horizon-live-coding.html', text: 'Découvrir le format →', secondary: true }, { href: 'https://luma.com/73hllnf6', text: 'Plus d\'info →' }] },
  { date: '2026-11-28', dateLabel: 'Samedi 28 novembre 2026', title: 'Initiation live coding Strudel aux Loop Sessions Worldwide', time: '10h - 12h', desc: 'Le Looper aux Loop Sessions Worldwide, « l\'événement du beatmaking » : faire groover des samples avec quelques lignes de code, et mettre les mains dedans. Gratuit, entrée libre à tout moment.', location: '📍 Bibliothèque d\'Étude et du Patrimoine, 1 rue de Périgord, Toulouse', links: [{ href: 'https://live-coding-strudel.vercel.app', text: 'Découvrir l\'atelier →' }] },
  { date: null, dateLabel: 'En discussion', title: 'Écoute collective d\'albums', desc: 'Session d\'écoute collective pour découvrir et partager des albums. Format et date à définir.', links: [{ href: '#impliquer', text: 'Ça m\'intéresse ! →' }] },
  { date: null, dateLabel: 'En discussion', title: 'Workflow #2', paragraphs: ['Deuxième session de la série Workflow. Thème et date à venir.', 'Vous souhaitez proposer un contenu ? Partagez votre process musical, vos compos, votre univers… Contactez-nous via Discord pour proposer votre intervention !'], links: [{ href: '/workflow.html', text: 'Découvrir le format →', secondary: true }, { href: '#impliquer', text: 'Ça m\'intéresse ! →' }] },
  { date: '2025-01-18', dateLabel: 'Dimanche 18 janvier 2025', title: 'Atelier "Horizon Live Coding #1"', time: '13h - 15h', desc: 'Découverte de Strudel.cc', location: '📍 <a href="https://eurekafe.fr/" target="_blank" rel="noopener noreferrer" class="event-location-link">Eurêkafé</a>, 5 Impasse Colombette, Toulouse', links: [{ href: '/horizon-live-coding.html', text: 'Découvrir le format →', secondary: true }, { href: 'https://tour-de-controle.notion.site/D-couverte-de-struddel-cc-2102974a82658071a542d2c0dbd6d6f6', text: 'En savoir plus →' }] },
  { date: '2025-06-01', dateLabel: 'Juin 2025', title: 'Workflow #1 — Sonic Pi', desc: 'Premier atelier de la série Workflow dédié à Sonic Pi, outil de live coding pour créer de la musique en temps réel.', links: [{ href: '/workflow.html', text: 'Découvrir le format →', secondary: true }, { href: 'https://www.youtube.com/watch?v=6deSpsZ6SCw', text: 'En savoir plus →' }] },
  { date: '2024-06-01', dateLabel: 'Avril 2023 — Juin 2024', title: 'Apéros mensuels', desc: 'Rencontres mensuelles régulières pour échanger, partager et créer ensemble autour de la musique numérique.', links: [{ href: 'https://www.facebook.com/events/189899184198290/?acontext=%7B%22event_action_history%22%3A[%7B%22surface%22%3A%22group%22%7D]%7D', text: 'En savoir plus →' }] },
];

const today = new Date();
today.setHours(0, 0, 0, 0);

// Les deux listes contiennent tous les événements datés : un script côté navigateur
// masque ceux qui ne sont pas à leur place selon la date du jour (le site est statique,
// sans lui l'agenda resterait figé à la date du dernier build).
const isPast = (e: { date: string | null }) => e.date !== null && new Date(e.date) < today;

const upcomingEvents = [...allAgendaEvents]
  .sort((a, b) => (a.date == null ? 1 : b.date == null ? -1 : (a.date as string).localeCompare(b.date as string)));

const archivedEvents = allAgendaEvents
  .filter((e) => e.date !== null)
  .sort((a, b) => (b.date as string).localeCompare(a.date as string));

const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
---

<Layout
  title="Le Looper - Création musicale numérique à Toulouse"
  description="Le Looper - Une communauté toulousaine pour créer, expérimenter et partager autour de la musique numérique. Rejoins la boucle !"
  currentPage="home"
  isHome={true}
>
  <Nav slot="nav" currentPage="home" isHome={true} />

  <section id="accueil" class="hero hero-home" aria-labelledby="hero-title">
    <div class="hero-background"></div>
    <div class="hero-content">
      <div class="hero-top">
        <img src="/img/logo.svg" alt="Le Looper" class="hero-logo" aria-hidden="true" />
        <h1 id="hero-title" class="hero-title">Le Looper</h1>
      </div>
      <div class="hero-bottom">
        <p class="hero-subtitle">
          Une communauté toulousaine pour créer, expérimenter et partager autour de la musique numérique.
        </p>
        <div class="hero-buttons">
          <a href="#" class="btn btn-primary" id="discordBtn" aria-label="Rejoindre le Discord du Looper">Rejoindre le Discord</a>
          <a href="#projet" class="btn btn-secondary">Découvrir le projet</a>
        </div>
      </div>
    </div>
  </section>

  <section id="projet" class="section" aria-labelledby="projet-title">
    <div class="container">
      <h2 id="projet-title" class="section-title">C'est quoi ?</h2>
      <div class="projet-intro">
        <p class="lead">Le Looper est un <strong>collectif</strong> qui rassemble des passionné·es de création musicale numérique à Toulouse.</p>
      </div>
      <div class="grid-3">
        <div class="projet-card">
          <div class="projet-card-icon" aria-hidden="true">🎯</div>
          <h3>Notre objectif</h3>
          <p>Créer un <strong>espace de pratique, de rencontres et de transmission</strong> autour de la musique numérique au sens large.</p>
        </div>
        <div class="projet-card">
          <div class="projet-card-icon" aria-hidden="true">🎵</div>
          <h3>Les pratiques</h3>
          <p>MAO, machines, live sets, live coding, sound design, beatmaking, improvisation, looping…</p>
        </div>
        <div class="projet-card">
          <div class="projet-card-icon" aria-hidden="true">🌟</div>
          <h3>Notre ambition</h3>
          <p><strong>Rassembler des gens de scènes différentes</strong>, décloisonner les styles, et rendre la pratique accessible à toutes et tous, sans barrière d'expertise.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="communaute" class="section section-alt" aria-labelledby="communaute-title">
    <div class="container">
      <h2 id="communaute-title" class="section-title">Pourquoi une communauté ?</h2>
      <div class="grid-2">
        <div class="content-card">
          <h3>Apprendre ensemble</h3>
          <p>On progresse plus vite quand on partage techniques, astuces et découvertes. La transmission et l'entraide sont au cœur du projet.</p>
        </div>
        <div class="content-card">
          <h3>Décloisonner</h3>
          <p>Pas de frontières de styles. Électronique, hip-hop, expérimental, ambient… Tous les univers se rencontrent et s'enrichissent mutuellement.</p>
        </div>
        <div class="content-card">
          <h3>Créer des opportunités</h3>
          <p>Collaborations, scènes, ateliers, jams… Ensemble, on crée des moments et des projets qui n'existeraient pas seuls.</p>
        </div>
        <div class="content-card">
          <h3>Rendre accessible</h3>
          <p>Anti-élite, anti-expertise obligatoire. Que tu sois débutant·e ou confirmé·e, tu as ta place. Le DIY et l'expérimentation sont encouragés.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="formats" class="section" aria-labelledby="formats-title">
    <div class="container">
      <h2 id="formats-title" class="section-title">À quoi ça ressemble ?</h2>
      <div class="content-card">
        <p class="lead">Des formats variés pour explorer et partager :</p>
        <ul class="formats-list">
          <li><strong><a href="/horizon-live-coding.html" class="format-link">Horizon Live Coding</a></strong> — espace de pratique horizontal dédié au live coding</li>
          <li><strong><a href="/workflow.html" class="format-link">Workflow</a></strong> — partage de processus de création musicale numérique</li>
          <li><strong>Jam / sessions d'impro</strong> — improvisation collective, live sets</li>
          <li><strong>Ateliers outils</strong> — découverte de logiciels et techniques (Ableton, Bitwig, Renoise, Sonic Pi, TidalCycles, Strudel…)</li>
          <li><strong>Écoutes collectives / démos</strong> — partage de créations, retours bienveillants</li>
          <li><strong>Mini-performances</strong> — moments de live, showcases</li>
          <li><strong>Rencontres / échanges</strong> — discussions, partage d'expériences</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="impliquer" class="section section-alt" aria-labelledby="impliquer-title">
    <div class="container">
      <h2 id="impliquer-title" class="section-title">Comment s'impliquer ?</h2>
      <div class="content-card">
        <p class="lead">Pas besoin d'être expert·e pour contribuer ! Voici des idées de micro-engagements :</p>
        <div class="roles-grid">
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">👋</span>
            <p>Venir une première fois et dire bonjour</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">💡</span>
            <p>Partager un outil / patch / technique en 5 minutes</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">🎵</span>
            <p>Proposer un thème de jam</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">📍</span>
            <p>Aider à trouver un lieu</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">🤝</span>
            <p>Aider à l'accueil le jour J</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">🎨</span>
            <p>Faire une mini-affiche / visuel</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">📹</span>
            <p>Filmer 30 secondes pour l'archive</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">🔌</span>
            <p>Ramener une enceinte / câble / multiprise</p>
          </div>
          <div class="role-card">
            <span class="role-icon" aria-hidden="true">🎓</span>
            <p>Proposer un atelier découverte</p>
          </div>
          <div class="role-card role-card-generic">
            <span class="role-icon" aria-hidden="true">💭</span>
            <p>J'ai quelque chose à proposer</p>
          </div>
        </div>
        <div class="cta-box">
          <p class="quote">"Je donne l'impulsion, mais le Looper se construit à plusieurs."</p>
          <a href="#" class="btn btn-primary" id="discordBtn2">Rejoindre le Discord</a>
        </div>
      </div>
    </div>
  </section>

  <section id="agenda" class="section" aria-labelledby="agenda-title">
    <div class="container">
      <h2 id="agenda-title" class="section-title">Agenda</h2>
      <p class="section-subtitle" style="text-align: center;">Tous les événements du Looper sont également disponibles sur Luma : <a href="https://luma.com/user/lelooper" target="_blank" rel="noopener noreferrer" class="format-link">consulter le calendrier complet</a>.</p>
      <div class="content-card">
        <div class="events-list">
          {upcomingEvents.map((event) => (
            <div class:list={['event-card', event.date === todayStr && 'event-card--today']} data-date={event.date ?? undefined} hidden={isPast(event)}>
              <div class="event-date">{event.dateLabel}{event.date && <span class="event-tag" hidden={event.date !== todayStr}>aujourd'hui</span>}</div>
              <h3>{event.title}</h3>
              {'paragraphs' in event ? (
                event.paragraphs!.map((p) => <p>{p}</p>)
              ) : (
                <p>
                  {event.time ? <><strong>{event.time}</strong> — </> : null}{event.desc}
                </p>
              )}
              {event.location && <p class="event-location" set:html={event.location} />}
              {event.links.length > 1 ? (
                <div class="event-links">
                  {event.links.map((link) => (
                    <a href={link.href} class:list={['event-info-link', (link as { href: string; text: string; secondary?: boolean }).secondary && 'event-info-link-secondary']} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                      {link.text}
                    </a>
                  ))}
                </div>
              ) : event.links.length === 1 ? (
                <a href={event.links[0].href} class="event-info-link">
                  {event.links[0].text}
                </a>
              ) : null}
            </div>
          ))}
        </div>

        <div class="archive-section">
          <h3 class="archive-section-title">Archives</h3>
          <div class="archive-list">
            {archivedEvents.map((event) => (
              <div class="archive-item" data-date={event.date} hidden={!isPast(event)}>
                <div class="archive-date">{event.dateLabel}</div>
                <h4>{event.title}</h4>
                {'paragraphs' in event ? (
                  event.paragraphs!.map((p) => <p>{p}</p>)
                ) : (
                  <p>
                    {event.time ? <><strong>{event.time}</strong> — </> : null}{event.desc}
                  </p>
                )}
                {event.location && <p class="event-location" set:html={event.location} />}
                {event.links.length > 1 ? (
                  <div class="archive-links">
                    {event.links.map((link) => (
                      <a href={link.href} class:list={['archive-info-link', (link as { href: string; text: string; secondary?: boolean }).secondary && 'archive-info-link-secondary']} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                        {link.text}
                      </a>
                    ))}
                  </div>
                ) : event.links.length === 1 ? (
                  <a href={event.links[0].href} class="archive-info-link" target={event.links[0].href.startsWith('http') ? '_blank' : undefined} rel={event.links[0].href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                    {event.links[0].text}
                  </a>
                ) : null}
              </div>
            ))}
          </div>
        </div>

        <script is:inline>
          (function () {
            var d = new Date();
            var today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            document.querySelectorAll('#agenda .event-card[data-date]').forEach(function (el) {
              var date = el.dataset.date;
              el.hidden = date < today;
              el.classList.toggle('event-card--today', date === today);
              var tag = el.querySelector('.event-tag');
              if (tag) tag.hidden = date !== today;
            });
            document.querySelectorAll('#agenda .archive-item[data-date]').forEach(function (el) {
              el.hidden = el.dataset.date >= today;
            });
          })();
        </script>

        <div class="cta-box">
          <p class="quote">Pour proposer ou voter pour un événement, rejoins le Discord.</p>
          <a href="#" class="btn btn-primary" id="discordBtn3">Rejoindre le Discord</a>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="section section-alt" aria-labelledby="contact-title">
    <div class="container">
      <h2 id="contact-title" class="section-title">Où nous trouver</h2>
      <div class="content-card">
        <p class="lead">Rejoins-nous sur nos différentes plateformes pour suivre l'actualité, échanger et participer à la communauté.</p>
        <div class="platforms-grid">
          <a href="#" class="platform-card" id="discordPlatformBtn" aria-label="Rejoindre le Discord du Looper">
            <div class="platform-icon discord-icon" aria-hidden="true">
              <svg viewBox="0 0 71 55" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M60.1045 4.8978C55.5792 2.8214 50.7265 1.2916 45.6527 0.41542C45.5603 0.39851 45.468 0.440769 45.4204 0.525289C44.7963 1.6353 44.1051 3.0834 43.6209 4.2216C38.1637 3.4046 32.7345 3.4046 27.3892 4.2216C26.905 3.0581 26.1886 1.6353 25.5617 0.525289C25.5141 0.443589 25.4218 0.40133 25.3294 0.41542C20.2584 1.2888 15.4057 2.8186 10.8776 4.8978C10.8384 4.9147 10.8048 4.9429 10.7825 4.9795C1.57795 18.7309 -0.943561 32.1443 0.293408 45.3914C0.299005 45.4562 0.335386 45.5182 0.385761 45.5576C6.45866 50.0174 12.3413 52.7249 18.1147 54.5194C18.2071 54.5477 18.305 54.5139 18.3638 54.4378C19.7295 52.5728 20.9469 50.6063 21.9907 48.5383C22.0523 48.4172 21.9935 48.2735 21.8676 48.2256C19.9366 47.4931 18.0979 46.6 16.3292 45.5858C16.1893 45.5041 16.1781 45.304 16.3068 45.2082C16.679 44.9293 17.0513 44.6391 17.4067 44.3461C17.471 44.2926 17.5606 44.2813 17.6362 44.3151C29.2558 49.6202 41.8354 49.6202 53.3179 44.3151C53.3935 44.2785 53.4831 44.2898 53.5502 44.3433C53.9057 44.6363 54.2779 44.9293 54.6529 45.2082C54.7816 45.304 54.7732 45.5041 54.6333 45.5858C52.8646 46.6197 51.0259 47.4931 49.0921 48.2228C48.9662 48.2707 48.9102 48.4172 48.9718 48.5383C50.038 50.6034 51.2554 52.5699 52.5959 54.435C52.6519 54.5139 52.7526 54.5477 52.845 54.5194C58.6464 52.7249 64.529 50.0174 70.6019 45.5576C70.6551 45.5182 70.6887 45.459 70.6943 45.3942C72.1747 30.0791 68.2147 16.7757 60.1968 4.9823C60.1772 4.9429 60.1437 4.9147 60.1045 4.8978ZM23.7259 37.3253C19.2272 37.3253 15.5151 33.6521 15.5151 29.1473C15.5151 24.6425 19.1577 20.9693 23.7259 20.9693C28.3304 20.9693 31.9743 24.6852 31.9171 29.1473C31.94 33.6521 28.3304 37.3253 23.7259 37.3253ZM47.3178 37.3253C42.8191 37.3253 39.107 33.6521 39.107 29.1473C39.107 24.6425 42.7496 20.9693 47.3178 20.9693C51.9223 20.9693 55.5663 24.6852 55.509 29.1473C55.532 33.6521 51.9223 37.3253 47.3178 37.3253Z" fill="currentColor"/>
              </svg>
            </div>
            <h3>Discord</h3>
            <p>Rejoins la communauté</p>
          </a>
          <a href="#" class="platform-card" id="instagramPlatformBtn" aria-label="Suivre Le Looper sur Instagram">
            <div class="platform-icon instagram-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" fill="currentColor"/>
              </svg>
            </div>
            <h3>Instagram</h3>
            <p>Suis notre actualité</p>
          </a>
          <a href="#" class="platform-card" id="facebookPagePlatformBtn" aria-label="Suivre la page Facebook du Looper">
            <div class="platform-icon facebook-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
